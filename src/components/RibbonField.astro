---
interface Props {
  name: string;
  tagline: string;
}

const { name, tagline } = Astro.props;
---

<section class="hero">
  <canvas id="ribbons" aria-hidden="true"></canvas>
  <div class="panel">
    <h1>{name}</h1>
    <p>{tagline}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: clamp(26rem, 68vh, 42rem);
    overflow: hidden;
    background: var(--bg);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .panel {
    position: absolute;
    left: clamp(1rem, 5vw, 4.5rem);
    bottom: clamp(2rem, 7vh, 4rem);
    max-width: min(90vw, 33rem);
    padding: 1.9rem 2.4rem 2rem;
    background: var(--surface);
    border: 7px solid var(--ink);
    pointer-events: none;
  }

  .panel h1 {
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 3.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: var(--ink);
  }

  .panel p {
    margin: 0.85rem 0 0;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    color: var(--muted);
  }
</style>

<script>
  const canvas = document.getElementById('ribbons') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: false })!;

    // --- Perlin noise (2D) -------------------------------------------------
    const perm = new Uint8Array(512);
    {
      const p = Uint8Array.from({ length: 256 }, (_, i) => i);
      for (let i = 255; i > 0; i--) {
        const j = (Math.random() * (i + 1)) | 0;
        [p[i], p[j]] = [p[j], p[i]];
      }
      for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
    }
    const fade = (t) => t * t * t * (t * (t * 6 - 15) + 10);
    const mix = (a, b, t) => a + t * (b - a);
    function grad(hh, x, y) {
      const g = hh & 7;
      const u = g < 4 ? x : y;
      const v = g < 4 ? y : x;
      return ((g & 1) ? -u : u) + ((g & 2) ? -2 * v : 2 * v);
    }
    function noise2(x, y) {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;
      x -= Math.floor(x);
      y -= Math.floor(y);
      const u = fade(x);
      const v = fade(y);
      const A = perm[X] + Y;
      const B = perm[X + 1] + Y;
      return mix(
        mix(grad(perm[A], x, y), grad(perm[B], x - 1, y), u),
        mix(grad(perm[A + 1], x, y - 1), grad(perm[B + 1], x - 1, y - 1), u),
        v
      );
    }

    // --- Tunables ----------------------------------------------------------
    const BG = '#f4e5c8';
    const BANDS = [
      '#1b3a63', // navy
      '#2e7a94', // teal
      '#8fb6c9', // powder blue
      '#dac050', // olive
      '#eec183', // sand
      '#e8813a', // orange
      '#d9452a', // vermilion
    ];
    const BAND_W = 40;        // ribbon thickness, px
    const STEPS = 850;        // horizontal resolution
    const AMP = 44;           // how much the group undulates
    const NOISE_S = 0.0022;   // lower = longer, lazier curves
    const DRIFT = 0.0022;     // how fast the shape evolves
    const SLOPE = 0.1;        // gentle diagonal across the canvas
    const LIGHT_W = 00;      // width of the travelling highlight, px
    const LIGHT_SPEED = 0.6;  // how fast it runs along the ribbon
    const LIGHT_STAGGER = 90; // offset between adjacent bands, px
    const LIGHT_STRENGTH = 0.5;
    const SHEEN = [255, 247, 230]; // warm white the highlight mixes toward
    const CURSOR_PUSH = 60;   // how hard the pointer parts the ribbons
    const CURSOR_RX = 145;    // how far along the ribbon the parting reaches, px
    const CURSOR_RY = 50;     // how many bands react — smaller = fewer

    let w = 0;
    let h = 0;
    let dpr = 1;
    let t = 0;

    const cursor = { on: false, x: 0, y: 0 };
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const rgbOf = (hex) => [
      parseInt(hex.slice(1, 3), 16),
      parseInt(hex.slice(3, 5), 16),
      parseInt(hex.slice(5, 7), 16),
    ];
    const BAND_RGB = BANDS.map(rgbOf);

    const groupH = () => BANDS.length * BAND_W;

    function centre(x) {
      return (
        h / 2 +
        noise2(x * NOISE_S, t * DRIFT) * AMP +
        (x - w / 2) * SLOPE
      );
    }

    // How far this band gets pushed at this x. Each band is judged on its own
    // distance from the pointer, so they part instead of moving as a block.
    function displace(x, bandY) {
      if (!cursor.on) return 0;
      const dx = x - cursor.x;
      const along = Math.exp(-(dx * dx) / (2 * CURSOR_RX * CURSOR_RX));
      const dy = cursor.y - bandY;
      const u = dy / CURSOR_RY;
      // smooth, signed falloff: zero directly under the pointer, peaks either side
      const across = u * Math.exp(-(u * u) / 2);
      return -CURSOR_PUSH * along * across;
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas!.getBoundingClientRect();
      w = r.width;
      h = r.height;
      canvas!.width = w * dpr;
      canvas!.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function frame() {
      ctx.fillStyle = BG;
      ctx.fillRect(0, 0, w, h);

      ctx.lineWidth = BAND_W;
      ctx.lineCap = 'butt';
      ctx.lineJoin = 'round';

      const x0 = -40;
      const x1 = w + 40;
      const dx = (x1 - x0) / STEPS;
      const span = w + 2 * LIGHT_W;
      const half = (BANDS.length - 1) / 2;

      // precompute the centreline once; every band is a copy of it
      const ys = new Float64Array(STEPS + 1);
      for (let s = 0; s <= STEPS; s++) ys[s] = centre(x0 + s * dx);

      for (let b = 0; b < BANDS.length; b++) {
        const offset = (b - half) * BAND_W;
        const base = BAND_RGB[b];
        const lightX = ((t * LIGHT_SPEED + b * LIGHT_STAGGER) % span) - LIGHT_W;

        // one gradient across the canvas carries the travelling highlight,
        // so each band is a single unbroken stroke — no seams
        const g = ctx.createLinearGradient(x0, 0, x1, 0);
        const at = (px) => Math.min(1, Math.max(0, (px - x0) / (x1 - x0)));
        const rgbStr = (m) =>
          `rgb(${(base[0] + (SHEEN[0] - base[0]) * m) | 0},${
            (base[1] + (SHEEN[1] - base[1]) * m) | 0
          },${(base[2] + (SHEEN[2] - base[2]) * m) | 0})`;

        g.addColorStop(0, rgbStr(0));
        const stops = [
          [lightX - LIGHT_W, 0],
          [lightX - LIGHT_W * 0.55, LIGHT_STRENGTH * 0.35],
          [lightX, LIGHT_STRENGTH],
          [lightX + LIGHT_W * 0.55, LIGHT_STRENGTH * 0.35],
          [lightX + LIGHT_W, 0],
        ];
        let last = 0;
        for (const [px, m] of stops) {
          const pos = at(px);
          if (pos <= last) continue;
          g.addColorStop(pos, rgbStr(m));
          last = pos;
        }
        g.addColorStop(1, rgbStr(0));

        ctx.strokeStyle = g;
        ctx.beginPath();
        for (let s = 0; s <= STEPS; s++) {
          const px = x0 + s * dx;
          const flat = ys[s] + offset;
          const py = flat + displace(px, flat);
          if (s === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.stroke();
      }
    }

    let running = false;
    let raf = 0;
    function loop() {
      t++;
      frame();
      raf = requestAnimationFrame(loop);
    }
    function start() {
      if (running || reduced) return;
      running = true;
      loop();
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    resize();
    frame();
    if (!reduced) start();

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        frame();
      }, 180);
    });

    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      cursor.on = true;
      cursor.x = e.clientX - r.left;
      cursor.y = e.clientY - r.top;
      if (reduced) frame();
    });
    canvas.addEventListener('pointerleave', () => {
      cursor.on = false;
      if (reduced) frame();
    });

    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), {
      threshold: 0,
    }).observe(canvas);

    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start()
    );
  }
</script>